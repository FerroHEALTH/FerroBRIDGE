# The overrides the performance gate (scripts/perf/gate.sh) gives this tree's
# bridge when it measures it as an arm, over this tree's perf/ferrobridge.toml.
# A tree carries its own, so a change to the configuration keys reaches the
# arm whose binary reads them and never the other. One NAME=VALUE per line;
# the gate fills @ARM@ (head or base), @FACADE_PORT@, @MLLP_PORT@, @CDR@ and
# @FACADE@ (the arm's CDR and facade origins), @DIR@ (the arm's work
# directory), @TLS@ (the MLLP certificates) and @TERMINOLOGY@ (the FerroTERM
# origin), and refuses any other placeholder. No specification governs this:
# our own design.
FERROBRIDGE__USAGE_REPORT__ENABLED=false
FERROBRIDGE__SERVER__LISTEN=127.0.0.1:@FACADE_PORT@
FERROBRIDGE__CDR__BASE_URL=@CDR@/ferroehr/rest/openehr/v1
FERROBRIDGE__MAPPINGS__DIRECTORY=@DIR@/mappings
FERROBRIDGE__FACADE__BASE_URL=@FACADE@/fhir
FERROBRIDGE__FACADE__IDENTITY_STORE=@DIR@/identity.redb
FERROBRIDGE__HL7V2__LISTEN=127.0.0.1:@MLLP_PORT@
FERROBRIDGE__HL7V2__TLS__CERTIFICATE_FILE=@TLS@/mllp-chain.pem
FERROBRIDGE__HL7V2__TLS__KEY_FILE=@TLS@/mllp-key.pem
FERROBRIDGE__HL7V2__TLS__CLIENT_CA_FILE=@TLS@/ca.pem
FERROBRIDGE__CHANGE_FEED__URL=@CDR@/ferroehr/rest/extensions/v1
FERROBRIDGE__CHANGE_FEED__DEAD_LETTERS=@DIR@/dead-letters.redb
FERROBRIDGE__EVENTS__EXCHANGE=ferrobridge.perf.@ARM@
FERROBRIDGE__TERMINOLOGY__BASE_URL=@TERMINOLOGY@/r4
FERROBRIDGE__TERMINOLOGY__WIRE_VERSION=r4
