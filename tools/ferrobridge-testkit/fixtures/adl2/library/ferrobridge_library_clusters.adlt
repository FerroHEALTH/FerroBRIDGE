-- SPDX-FileCopyrightText: Cadasto B.V.
-- SPDX-License-Identifier: BUSL-1.1
-- FerroBRIDGE's template for the FHIRconnect mapping library cluster models
-- no library file slots, over five published CKM archetypes
-- (fixtures/ckm/library, fixtures/ckm/medication, fixtures/ckm/highmed): a
-- report COMPOSITION whose context holds CLUSTER.observation_status_fhir.v1
-- and CLUSTER.organization.v0, and whose content holds ACTION.medication.v1
-- with CLUSTER.medication_status_fhir.v0 in its open protocol slot. No
-- specification governs this template: our own design, carrying the
-- archetypes the mappings name. Node identifiers are at-coded, the ADL 1.4
-- codes of the CKM sources.

template (adl_version=2.4.0; rm_release=1.1.0)
    openEHR-EHR-COMPOSITION.ferrobridge_library_clusters.v1.0.0

specialize
    openEHR-EHR-COMPOSITION.report.v1

language
    original_language = <[ISO_639-1::en]>

description
    lifecycle_state = <"unmanaged">
    original_author = <
        ["name"] = <"FerroBRIDGE">
    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The FHIRconnect mapping library cluster models FerroBRIDGE slots over the CKM archetypes.">
        >
    >

definition
    COMPOSITION[at0000.1] matches {
        /context/other_context[at0001]/items matches {
            use_archetype CLUSTER[at0006.1, openEHR-EHR-CLUSTER.observation_status_fhir.v1]
            use_archetype CLUSTER[at0006.2, openEHR-EHR-CLUSTER.organization.v0]
        }
        /content matches {
            use_archetype ACTION[at0000.2, openEHR-EHR-ACTION.medication-ferrobridge.v1]
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000.1"] = <
                text = <"Library clusters">
                description = <"Library clusters">
            >
            ["at0006.1"] = <
                text = <"Observation status">
                description = <"Observation status">
            >
            ["at0006.2"] = <
                text = <"Organization">
                description = <"Organization">
            >
            ["at0000.2"] = <
                text = <"Medication management">
                description = <"Medication management">
            >
        >
    >

------------------------------------------------------------------------
template_overlay
    openEHR-EHR-ACTION.medication-ferrobridge.v1.0.0

specialize
    openEHR-EHR-ACTION.medication.v1

language
    original_language = <[ISO_639-1::en]>

description
    lifecycle_state = <"unmanaged">
    original_author = <
        ["name"] = <"FerroBRIDGE">
    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The FHIRconnect mapping library cluster models FerroBRIDGE slots over the CKM archetypes.">
        >
    >

definition
    ACTION[at0000.1] matches {
        /protocol[at0030]/items matches {
            use_archetype CLUSTER[at0085.1, openEHR-EHR-CLUSTER.medication_status_fhir.v0]
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000.1"] = <
                text = <"Medication management">
                description = <"Medication management">
            >
            ["at0085.1"] = <
                text = <"Medication status">
                description = <"Medication status">
            >
        >
    >
