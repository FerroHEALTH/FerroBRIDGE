-- SPDX-License-Identifier: BUSL-1.1
-- FerroBRIDGE's EHDS record template over published CKM archetypes: an
-- encounter COMPOSITION (fixtures/ckm/medication) whose content holds each
-- entry the draft EEHRxF Annex X data groups take from no other template,
-- once per archetype so a context starting at one places it unambiguously:
-- the ACTION.medication.v1 of an immunisation (fixtures/ckm/medication) and
-- the OBSERVATION.body_weight.v2 of a simple observation (fixtures/ckm/ehds).
-- No specification governs this template: our own design for the Annex X
-- facade resources. Node identifiers are at-coded, the ADL 1.4 codes of the
-- CKM sources.

template (adl_version=2.4.0; rm_release=1.1.0)
    openEHR-EHR-COMPOSITION.ferrobridge_ehds_record.v1.0.0

specialize
    openEHR-EHR-COMPOSITION.encounter.v1

language
    original_language = <[ISO_639-1::en]>

description
    lifecycle_state = <"unmanaged">
    original_author = <
        ["name"] = <"FerroBRIDGE">
    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The draft EEHRxF Annex X data groups served as individual resources by FerroBRIDGE.">
        >
    >

definition
    COMPOSITION[at0000.1] matches {
        content matches {
            use_archetype ACTION[at0000.2, openEHR-EHR-ACTION.medication.v1] occurrences matches {0..*}
            use_archetype OBSERVATION[at0000.3, openEHR-EHR-OBSERVATION.body_weight.v2] occurrences matches {0..*}
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000.1"] = <
                text = <"EHDS record">
                description = <"One entry of a draft EEHRxF Annex X data group.">
            >
            ["at0000.2"] = <
                text = <"Immunisation">
                description = <"The vaccine administration an Immunization carries.">
            >
            ["at0000.3"] = <
                text = <"Body weight">
                description = <"The body weight a vital-signs Observation carries.">
            >
        >
    >
