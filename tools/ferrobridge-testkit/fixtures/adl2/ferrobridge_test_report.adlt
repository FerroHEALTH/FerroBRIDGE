-- SPDX-License-Identifier: BUSL-1.1
-- FerroBRIDGE's medical test report template over three published CKM
-- archetypes: a COMPOSITION.report-result.v1 (fixtures/ckm/library) holding
-- an OBSERVATION.spirometry_result.v2 or an OBSERVATION.ecg_result.v1
-- (fixtures/ckm/test-report), the non-laboratory tests of draft EEHRxF
-- Annex VIII. The international CKM publishes no such composition template,
-- so no specification governs this template: our own design. Node
-- identifiers are at-coded, the ADL 1.4 codes of the CKM sources.

template (adl_version=2.4.0; rm_release=1.1.0)
    openEHR-EHR-COMPOSITION.ferrobridge_test_report.v1.0.0

specialize
    openEHR-EHR-COMPOSITION.report-result.v1

language
    original_language = <[ISO_639-1::en]>

description
    lifecycle_state = <"unmanaged">
    original_author = <
        ["name"] = <"FerroBRIDGE">
    >
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"The draft EEHRxF Annex VIII medical test report of FerroBRIDGE.">
        >
    >

definition
    COMPOSITION[at0000.1] matches {
        /content matches {
            use_archetype OBSERVATION[at0000.2, openEHR-EHR-OBSERVATION.spirometry_result.v2]
            use_archetype OBSERVATION[at0000.3, openEHR-EHR-OBSERVATION.ecg_result.v1]
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["at0000.1"] = <
                text = <"Medical test report">
                description = <"A non-laboratory diagnostic test reported to the patient's record.">
            >
            ["at0000.2"] = <
                text = <"Spirometry result">
                description = <"The spirometry test a DiagnosticReport carries.">
            >
            ["at0000.3"] = <
                text = <"ECG result">
                description = <"The electrocardiogram a DiagnosticReport carries.">
            >
        >
    >
