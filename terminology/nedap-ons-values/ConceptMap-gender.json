{
  "resourceType": "ConceptMap",
  "id": "gender",
  "url": "https://ferrobridge.eu/fhir/nedap-ons/ConceptMap/gender",
  "name": "NedapOnsGenderToAdministrativeGender",
  "title": "Nedap Ons client gender to administrative-gender",
  "status": "active",
  "experimental": true,
  "publisher": "Cadasto B.V. (FerroBRIDGE)",
  "description": "Maps the gender of an Ons API client to the R4 administrative-gender the Nedap Ons template's map writes into Patient.gender.",
  "sourceUri": "https://ferrobridge.eu/fhir/nedap-ons/CodeSystem/gender",
  "targetUri": "http://hl7.org/fhir/ValueSet/administrative-gender",
  "group": [
    {
      "source": "https://ferrobridge.eu/fhir/nedap-ons/CodeSystem/gender",
      "target": "http://hl7.org/fhir/administrative-gender",
      "element": [
        {"code": "M", "target": [{"code": "male", "equivalence": "equivalent"}]},
        {"code": "F", "target": [{"code": "female", "equivalence": "equivalent"}]},
        {"code": "X", "target": [{"code": "other", "equivalence": "equivalent"}]},
        {"code": "U", "target": [{"code": "unknown", "equivalence": "equivalent"}]}
      ]
    }
  ]
